{
  "permissions": {
    "allow": ["Bash(npm run *)", "Bash(npx playwright *)", "Bash(git add *)",
      "Bash(git commit *)", "Bash(gh pr *)", "Bash(gh run *)"]
  },
  "hooks": {
    "PreToolUse": [{ "matcher": "Edit|Write",
      "hooks": [{ "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/protect.sh" }] }],
    "Stop": [{
      "hooks": [{ "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/run-checks.sh" }] }]
  }
}