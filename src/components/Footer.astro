---
import Todo from './Todo.astro';
import { externalAttrs } from '../lib/external-links.mjs';

interface Props {
  siteName: string;
  hasPosts: boolean;
  links: { label: string; url: string }[];
}
const { siteName, hasPosts, links } = Astro.props;
const nav = [
  { href: '/', label: 'Home' },
  { href: '/projects/', label: 'Projects' },
  ...(hasPosts ? [{ href: '/posts/', label: 'Posts' }] : []),
];
/** rel="me" plus, for external links, the new-tab attributes. */
const withRel = (url: string, rel: string) => {
  const ext: { target?: string; rel?: string } = externalAttrs(url);
  return { ...ext, rel: [rel, ext.rel].filter(Boolean).join(' ') };
};
const legal = [
  { href: '/imprint/', label: 'Imprint' },
  { href: '/privacy/', label: 'Privacy' },
];
---

<footer class="site-footer wrap">
  <div class="rows">
    <nav aria-label="Footer">
      <ul class="nav">{nav.map((l) => <li><a class="display" href={l.href}>{l.label}</a></li>)}</ul>
    </nav>
    <div aria-label="Elsewhere" role="group">
      {
        links.length > 0 ? (
          <ul>
            {links.map((l) => (
              <li>
                <a class="label" href={l.url} {...withRel(l.url, 'me')}>
                  {l.label}
                </a>
              </li>
            ))}
          </ul>
        ) : (
          <Todo what="contact and social links (links in src/content/site/home.md)" />
        )
      }
    </div>
    <ul class="legal">{legal.map((l) => <li><a class="label" href={l.href}>{l.label}</a></li>)}</ul>
  </div>
  <p class="label colophon">{siteName} · Set in Literata and VT323</p>
</footer>

<style>
  .site-footer {
    margin-top: var(--space-6);
    padding-bottom: var(--space-4);
  }
  .rows {
    display: grid;
    gap: var(--space-2);
    padding-top: var(--space-3);
    border-top: 1px solid var(--rule);
  }
  ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1) var(--space-3);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  a {
    text-decoration: none;
  }
  .nav a {
    font-size: 1.35rem;
    line-height: 1;
    color: var(--muted);
  }
  a:hover {
    color: var(--text);
    text-decoration: underline;
    text-decoration-color: var(--accent);
  }
  .colophon {
    margin: var(--space-4) 0 0;
  }
</style>
