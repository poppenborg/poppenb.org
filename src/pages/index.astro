---
import { render } from 'astro:content';
import Base from '../layouts/Base.astro';
import Hook from '../components/Hook.astro';
import ProjectList from '../components/ProjectList.astro';
import PostList from '../components/PostList.astro';
import SectionHeading from '../components/SectionHeading.astro';
import Todo from '../components/Todo.astro';
import hookArt from '../assets/hook-grid.svg?raw';
import { getPosts, getProjects, getSiteText } from '../lib/content';

const home = await getSiteText('home');
const Intro = home?.body?.trim() ? (await render(home)).Content : undefined;
const projects = (await getProjects()).slice(0, 3);
const posts = (await getPosts()).slice(0, 3);
---

<Base>
  <div class="wrap">
    <section class="hero">
      <div class="hook-art" data-hook-art aria-hidden="true" set:html={hookArt} />
      {home?.data.hook ? <Hook text={home.data.hook} /> : <h1><Todo what="hook line (hook in src/content/site/home.md)" /></h1>}
      <div class="intro prose">
        {Intro ? <Intro /> : <Todo block what="short intro (body of src/content/site/home.md)" />}
      </div>
    </section>

    <section class="block" aria-labelledby="latest-projects">
      <SectionHeading id="latest-projects" href="/projects/" linkLabel="All projects">Latest projects</SectionHeading>
      {projects.length > 0 ? <ProjectList projects={projects} /> : <Todo block what="projects (Markdown files in src/content/projects/)" />}
    </section>

    {
      posts.length > 0 && (
        <section class="block" aria-labelledby="latest-posts">
          <SectionHeading id="latest-posts" href="/posts/" linkLabel="All posts">
            Latest posts
          </SectionHeading>
          <PostList posts={posts} />
        </section>
      )
    }
  </div>
</Base>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    padding-block: clamp(3rem, 12vh, 8rem) var(--space-5);
  }
  /* Leonard's corner-grid illustration, behind the hook. Tiles rest in
     --rule and warm towards amber with the hook (see Hook.astro). The amber
     is capped at 25% so swollen amber letters stay readable on top. */
  .hook-art {
    position: absolute;
    z-index: -1;
    inset-block-start: 0;
    inset-inline-end: 0;
    width: min(100%, 27rem);
    aspect-ratio: 1;
    pointer-events: none;
  }
  .hook-art :global(svg) {
    display: block;
    width: 100%;
    height: 100%;
  }
  .hook-art :global(path) {
    --p: 0;
    fill: color-mix(in oklab, var(--accent) calc(var(--p) * 25%), var(--rule));
  }
  .intro {
    margin-top: var(--space-4);
    max-width: 34rem;
    font-size: 1.08em;
  }
  .block + .block {
    margin-top: var(--space-5);
  }
</style>
