---
import Base from '../../layouts/Base.astro';
import ProjectList from '../../components/ProjectList.astro';
import Todo from '../../components/Todo.astro';
import { getProjects } from '../../lib/content';

const projects = await getProjects();
---

<Base title="Projects" description="Projects, newest first.">
  <div class="wrap">
    <header class="page-head">
      <p class="label">Index</p>
      <h1>Projects</h1>
    </header>
    {projects.length > 0 ? <ProjectList projects={projects} /> : <Todo block what="projects (Markdown files in src/content/projects/)" />}
  </div>
</Base>

<style>
  .page-head {
    padding-block: var(--space-5) var(--space-3);
  }
  h1 {
    margin: 0.3rem 0 0;
    font-size: clamp(2.2rem, 1.6rem + 3vw, 3.2rem);
    line-height: 1.1;
    font-weight: 560;
    letter-spacing: -0.015em;
  }
  .page-head p {
    margin: 0;
  }
</style>
